      () => AuthRegisterFormBloc(),
    );

    getIt.registerLazySingleton(
      () => AuthLoginUseCase(
        getIt<AuthRepositoryImpl>(),
      ),
    );

    getIt.registerLazySingleton(
      () => AuthLogoutUseCase(
        getIt<AuthRepositoryImpl>(),
      ),
    );

    getIt.registerLazySingleton(
      () => AuthRegisterUseCase(
        getIt<AuthRepositoryImpl>(),
      ),
    );

    getIt.registerLazySingleton(
      () => AuthCheckSignInStatusUseCase(
        getIt<AuthRepositoryImpl>(),
      ),
